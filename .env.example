# Never commit real credentials.
# Baseline precedence: CLI > this file > process environment > defaults.
# Inspect without API calls: uv run langmem-eval --systems amem --show-config
OPENAI_API_KEY=
# API root, not the full /chat/completions endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# --llm-model overrides LLM_MODEL. A-Mem uses this model for memory and answering.
LLM_MODEL=gpt-4.1-mini
# Provider-specific options, only when supported; applied to A-Mem and unified answers.
# LLM_EXTRA_BODY={"enable_thinking":false}
# Unified evaluation adapter; native baselines retain their own answer settings.
EVAL_PROTOCOL=auto
EVAL_CONTEXT_TOKENS=6000
EVAL_TOKENIZER=cl100k_base
EVAL_TOP_K=20
# Leave unset to use protocol defaults: locomo=256, longmemeval=512.
# EVAL_MAX_OUTPUT_TOKENS=256
EVAL_TEMPERATURE=0.1
EVAL_EMPTY_CONTEXT=abstain
EVAL_ABSTENTION_TEXT=None
# Runtime paths are relative to the working directory, or may be absolute.
# EVAL_DATA_DIR=data
# EVAL_MODELS_DIR=models
# EVAL_RESULTS_DIR=results

# Shared embeddings for A-Mem and LangMem evaluation (independent of AML_*).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false
# Pin a Hugging Face commit for reproducible local model weights.
# EMBEDDING_REVISION=
# For API embeddings set provider=openai and replace the model above.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://your-embedding-provider/v1
# EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=10
# Only algorithm-specific settings retain the AMEM_ prefix.
AMEM_RESPONSE_FORMAT=json_schema
AMEM_NEIGHBOR_K=5
AMEM_EVOLUTION_THRESHOLD=100
AMEM_TEMPERATURE=0.7
AMEM_MAX_OUTPUT_TOKENS=1000

AML_API_KEY=replace-with-a-long-random-service-key
AML_LLM_API_KEY=
AML_LLM_BASE_URL=https://api.openai.com/v1
AML_LLM_MODEL=gpt-4o-mini
# Set the actual OpenAI-compatible endpoint for your embedding provider.
AML_EMBEDDING_API_KEY=
AML_EMBEDDING_BASE_URL=
AML_EMBEDDING_MODEL=text-embedding-v4
# Confirm dimension support with your chosen provider.
AML_EMBEDDING_DIMS=1024
AML_DATABASE=data/aml.sqlite3
AML_SYSTEM_VERSION=langmem-aml-v1
AML_METHOD=langmem
AML_HOST=127.0.0.1
AML_PORT=8000
